    "并行计算"
  ],

  "core_concepts": [
    {
      "name": "Self-Attention",
      "name_zh": "自注意力机制",
      "formula": "Attention(Q,K,V) = softmax(QK^T/√d_k)V",
      "intuition": "让每个词都能关注句子里其他相关的词，不管距离多远",
      "analogy": "Query=我在找什么, Key=你有什么, Value=那我拿走你有的东西"
    },
    {
      "name": "Multi-Head Attention",
      "name_zh": "多头注意力",
      "formula": "MultiHead(Q,K,V) = Concat(head_1,...,head_h)W^O",
      "intuition": "同时从多个角度理解句子",
      "analogy": "多个侦探同时从不同角度调查案件"
    },
    {
      "name": "Positional Encoding",
      "name_zh": "位置编码",
      "formula": "PE(pos,2i) = sin(pos/10000^(2i/d))",
      "intuition": "让模型知道词的先后顺序",
      "analogy": "给每个词发带编号的工牌"
    }
  ],

  "architecture": {
    "type": "Encoder-Decoder",
    "encoder_layers": 6,
    "decoder_layers": 6,
    "d_model": 512,
    "n_heads": 8,
    "d_ff": 2048,
    "components": [
      "Multi-Head Attention",
      "Feed Forward Network",
      "Layer Normalization",
      "Residual Connection"
    ]
  },

  "problems_solved": [
    {
      "problem": "RNN不能并行计算",
      "solution": "Transformer可并行处理整个序列",
      "improvement": "训练速度提升10倍以上"
    },
    {
      "problem": "长序列遗忘问题",
      "solution": "Self-Attention直接连接任意距离",
      "improvement": "无遗忘问题"
    }
  ],

  "impact": {
    "historical_position": "易筋经 - 打通任督二脉",
    "derived_models": [
